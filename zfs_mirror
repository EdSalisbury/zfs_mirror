#!/usr/bin/env python3
"""
Simple ZFS mirror helper for data/media.

Behavior:
- Takes a recursive snapshot of data/media with prefix "sync-<timestamp>".
- For each remote target:
    * Resume any pending receive (if a receive_resume_token exists).
    * Determine the latest remote snapshot with the same prefix.
    * Send an incremental (-I base new) with -R; if no base, send full (-R new).
- Logs to /var/log/zfs_mirror.log; by default stdout/stderr are redirected there so cron/background runs stay quiet. Use --stdout to also echo to console.
- Remote ZFS binary path can be set per target (zfs_cmd).

Requires passwordless SSH from the user running this script to each remote.
"""

import argparse
import datetime
import json
import logging
import os
from pathlib import Path
import shlex
import signal
import subprocess
import sys
from typing import Iterable, List, Optional, Dict, Any

DATASET = "data/media"
SNAP_PREFIX = "sync"
DEFAULT_LOG_FILE = os.environ.get("LOG_FILE", "/var/log/zfs_mirror.log")
DEFAULT_CONFIG_PATH = os.environ.get(
    "TARGETS_CONFIG", str(Path(__file__).with_name("targets.json"))
)


def configure_logging(log_file: str, also_stdout: bool) -> None:
    handlers = []
    try:
        os.makedirs(os.path.dirname(log_file) or ".", exist_ok=True)
        handlers.append(logging.FileHandler(log_file))
    except OSError:
        handlers.append(logging.StreamHandler(sys.stdout))
    if also_stdout:
        handlers.append(logging.StreamHandler(sys.stdout))
    logging.basicConfig(
        level=logging.INFO,
        format="%(asctime)s %(levelname)s %(message)s",
        handlers=handlers,
    )


def run(
    cmd: List[str],
    *,
    check: bool = True,
    capture_output: bool = True,
    text: bool = True,
) -> subprocess.CompletedProcess:
    logging.debug("Running: %s", " ".join(shlex.quote(c) for c in cmd))
    return subprocess.run(
        cmd,
        check=check,
        capture_output=capture_output,
        text=text,
    )


def redirect_stdio_to_log(log_file: str) -> None:
    """
    Redirect stdout/stderr of this process (and children) to log_file.
    Keeps line buffering for readability.
    """
    try:
        os.makedirs(os.path.dirname(log_file) or ".", exist_ok=True)
        log_fh = open(log_file, "a", buffering=1)
        os.dup2(log_fh.fileno(), sys.stdout.fileno())
        os.dup2(log_fh.fileno(), sys.stderr.fileno())
    except OSError:
        # If redirection fails, continue without redirect.
        pass


def log_proc_error(exc: subprocess.CalledProcessError, context: str) -> None:
    stdout = exc.stdout.strip() if isinstance(exc.stdout, str) else exc.stdout
    stderr = exc.stderr.strip() if isinstance(exc.stderr, str) else exc.stderr
    logging.error("%s: command failed (%s)", context, exc)
    if stdout:
        logging.error("%s: stdout: %s", context, stdout)
    if stderr:
        logging.error("%s: stderr: %s", context, stderr)


def ignore_interactive_signals() -> None:
    """
    Ignore job-control/HUP signals so terminals cannot stop the pipeline.
    """
    for sig in (signal.SIGTSTP, signal.SIGTTIN, signal.SIGTTOU, signal.SIGHUP):
        try:
            signal.signal(sig, signal.SIG_IGN)
        except Exception:
            pass


def daemonize_once() -> None:
    """
    Double-fork to detach from the controlling terminal.
    Parent exits with 0; child continues in the background.
    """
    if os.environ.get("ZFS_MIRROR_DAEMONIZED") == "1":
        return
    try:
        pid = os.fork()
        if pid > 0:
            os._exit(0)
    except AttributeError:
        return  # not supported (non-POSIX)
    os.setsid()
    try:
        pid = os.fork()
        if pid > 0:
            os._exit(0)
    except OSError:
        pass
    os.environ["ZFS_MIRROR_DAEMONIZED"] = "1"
    try:
        with open(os.devnull, "rb") as devnull:
            os.dup2(devnull.fileno(), sys.stdin.fileno())
    except Exception:
        pass


def load_targets(config_path: str) -> List[Dict[str, Any]]:
    path = Path(config_path)
    if not path.exists():
        logging.error("Config file not found: %s", config_path)
        return []
    try:
        data = json.loads(path.read_text())
    except Exception as exc:  # broad: JSON parse errors
        logging.error("Failed to parse config %s: %s", config_path, exc)
        return []

    if not isinstance(data, list):
        logging.error("Config %s must be a JSON array of targets", config_path)
        return []

    targets: List[Dict[str, Any]] = []
    for idx, entry in enumerate(data):
        if not isinstance(entry, dict):
            logging.error("Config entry %s is not an object", idx)
            continue
        missing = [k for k in ("host", "port", "user", "dataset") if k not in entry]
        if missing:
            logging.error("Config entry %s missing keys: %s", idx, ", ".join(missing))
            continue
        try:
            target = {
                "host": str(entry["host"]),
                "port": int(entry["port"]),
                "user": str(entry["user"]),
                "dataset": str(entry["dataset"]),
                "zfs_cmd": str(entry.get("zfs_cmd", "zfs")),
            }
        except Exception as exc:
            logging.error("Config entry %s invalid: %s", idx, exc)
            continue
        targets.append(target)

    return targets


def latest_local_snapshot() -> Optional[str]:
    cp = run(
        ["zfs", "list", "-H", "-t", "snapshot", "-o", "name", "-r", DATASET]
    )
    snaps = [
        line.strip()
        for line in cp.stdout.splitlines()
        if f"@{SNAP_PREFIX}-" in line
    ]
    return snaps[-1] if snaps else None


def create_snapshot() -> str:
    snap_name = f"{DATASET}@{SNAP_PREFIX}-{datetime.datetime.now():%Y%m%d-%H%M%S}"
    logging.info("Creating snapshot %s", snap_name)
    run(["zfs", "snapshot", "-r", snap_name], capture_output=False)
    return snap_name


def ssh_cmd(host: str, port: int, user: str, remote_cmd: Iterable[str]) -> List[str]:
    return ["ssh", "-p", str(port), "-o", "BatchMode=yes", f"{user}@{host}", *remote_cmd]


def remote_zfs_cmd(target: dict, *args: str) -> List[str]:
    cmd = target.get("zfs_cmd", "zfs")
    return [cmd, *args]


def latest_remote_snapshot(target: dict) -> Optional[str]:
    cmd = ssh_cmd(
        target["host"],
        target["port"],
        target["user"],
        remote_zfs_cmd(target, "list", "-H", "-t", "snapshot", "-o", "name", "-r", target["dataset"]),
    )
    try:
        cp = run(cmd)
    except subprocess.CalledProcessError:
        return None
    snaps = [
        line.strip()
        for line in cp.stdout.splitlines()
        if f"@{SNAP_PREFIX}-" in line
    ]
    return snaps[-1] if snaps else None


def remote_resume_token(target: dict) -> Optional[str]:
    cmd = ssh_cmd(
        target["host"],
        target["port"],
        target["user"],
        remote_zfs_cmd(target, "get", "-H", "-o", "value", "receive_resume_token", target["dataset"]),
    )
    try:
        cp = run(cmd)
    except subprocess.CalledProcessError:
        return None
    token = cp.stdout.strip()
    return token if token and token != "-" else None


def pipe_commands(send_cmd: List[str], recv_cmd: List[str]) -> None:
    logging.debug("Send: %s", " ".join(shlex.quote(c) for c in send_cmd))
    logging.debug("Recv: %s", " ".join(shlex.quote(c) for c in recv_cmd))
    with subprocess.Popen(send_cmd, stdout=subprocess.PIPE) as sender:
        with subprocess.Popen(recv_cmd, stdin=sender.stdout) as receiver:
            sender.stdout.close()  # allow sender to receive SIGPIPE if receiver exits
            send_rc = sender.wait()
            recv_rc = receiver.wait()
            if send_rc != 0:
                raise subprocess.CalledProcessError(send_rc, send_cmd)
            if recv_rc != 0:
                raise subprocess.CalledProcessError(recv_rc, recv_cmd)


def resume_if_needed(target: dict) -> None:
    token = remote_resume_token(target)
    if not token:
        return
    logging.info("Resuming interrupted receive on %s:%s for %s", target["host"], target["port"], target["dataset"])
    send_cmd = ["zfs", "send", "-v", "-t", token]
    recv_cmd = ssh_cmd(
        target["host"],
        target["port"],
        target["user"],
        remote_zfs_cmd(target, "recv", "-vFsu", target["dataset"]),
    )
    pipe_commands(send_cmd, recv_cmd)
    logging.info("Resume complete for %s:%s %s", target["host"], target["port"], target["dataset"])


def send_snapshot(snap: str, target: dict) -> None:
    base = latest_remote_snapshot(target)
    if base:
        logging.info(
            "Sending incremental %s -> %s to %s:%s (%s)",
            base,
            snap,
            target["host"],
            target["port"],
            target["dataset"],
        )
        send_cmd = ["zfs", "send", "-vR", "-I", base, snap]
    else:
        logging.info(
            "Sending full %s to %s:%s (%s)",
            snap,
            target["host"],
            target["port"],
            target["dataset"],
        )
        send_cmd = ["zfs", "send", "-vR", snap]
    recv_cmd = ssh_cmd(
        target["host"],
        target["port"],
        target["user"],
        remote_zfs_cmd(target, "recv", "-vFsu", target["dataset"]),
    )
    pipe_commands(send_cmd, recv_cmd)
    logging.info("Replication to %s:%s %s complete", target["host"], target["port"], target["dataset"])


def main() -> int:
    parser = argparse.ArgumentParser(description="ZFS mirror helper for data/media.")
    parser.add_argument("--log-file", default=DEFAULT_LOG_FILE, help="Log file path")
    parser.add_argument(
        "--detach",
        dest="detach",
        action="store_true",
        default=True,
        help="Run in background (default). Use --foreground to stay attached.",
    )
    parser.add_argument(
        "--foreground",
        dest="detach",
        action="store_false",
        help="Run in foreground (no daemonize).",
    )
    parser.add_argument(
        "--config",
        default=DEFAULT_CONFIG_PATH,
        help="Path to JSON targets config (default: ./targets.json or TARGETS_CONFIG env)",
    )
    parser.add_argument(
        "--stdout",
        action="store_true",
        help="Also log to stdout (do not redirect stdio exclusively to file)",
    )
    parser.add_argument(
        "--no-redirect-stdio",
        action="store_true",
        help="Do not redirect stdout/stderr to log file (useful for interactive runs)",
    )
    args = parser.parse_args()

    if args.detach:
        daemonize_once()

    if not args.stdout and not args.no_redirect_stdio:
        redirect_stdio_to_log(args.log_file)

    ignore_interactive_signals()
    configure_logging(args.log_file, also_stdout=args.stdout)
    logging.info("=== zfs_mirror start: source=%s prefix=%s ===", DATASET, SNAP_PREFIX)

    targets = load_targets(args.config)
    if not targets:
        logging.error("No valid targets loaded; aborting.")
        return 1

    snap = create_snapshot()
    for target in targets:
        logging.info(
            "--- Target: %s@%s:%s -> %s (zfs=%s) ---",
            target["user"],
            target["host"],
            target["port"],
            target["dataset"],
            target.get("zfs_cmd", "zfs"),
        )
        try:
            resume_if_needed(target)
            send_snapshot(snap, target)
        except subprocess.CalledProcessError as exc:
            log_proc_error(
                exc,
                f"Replication failed for {target['user']}@{target['host']}:{target['port']} -> {target['dataset']}",
            )
            return 1

    logging.info("=== zfs_mirror done: %s ===", snap)
    return 0


if __name__ == "__main__":
    sys.exit(main())
